# Template for environment variables used by cmp-demo.
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored; this file is committed. Keep only placeholder
# values here, never real secrets.

# LLM: DashScope (Alibaba Cloud Model Studio, OpenAI-compatible endpoint)
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-api-key-here
MODEL=qwen-plus

# Which backend to use: dashscope | ollama (not read by the code yet)
LLM_PROVIDER=dashscope

# News search: Serper (https://serper.dev), used by search_google_news
SERPER_API_KEY=your-serper-api-key-here

# Email over SMTP (SSL), used by send_email_with_attachment
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
EMAIL_USER=you@example.com
EMAIL_PASS=your-smtp-password-or-app-password
